{
  "name": "dsh-plugin-switchboard",
  "version": "0.1.1",
  "description": "Sidebar switchboard for installed DSH plugins: toggle rows, spot restart-required changes, relaunch the host.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnJiaqi0926/dsh-plugin-switchboard.git"
  },
  "homepage": "https://github.com/AnJiaqi0926/dsh-plugin-switchboard#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
